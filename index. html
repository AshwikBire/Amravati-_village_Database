function fmt(n){return n.toLocaleString('en-IN');}

function renderTaluka(rows){
  document.querySelector('#talukaTable tbody').innerHTML = rows.map(r=>{
    const cls = r.hqtag==='forest'?'forest':(r.hqtag==='urban'?'urban':'unverified');
    const label = r.hqtag==='forest'?'वन/आदिवासी मुख्यालय':(r.hqtag==='urban'?'नगर/नगरपालिका मुख्यालय':'वैधानिक शहर नाही');
    return `<tr><td>${r.taluka}</td><td>${r.hq}</td><td>${r.subdiv}</td>
      <td class="num">${fmt(r.pop)}</td><td class="num">${r.villages}</td><td class="num">${r.gp}</td>
      <td class="num">${r.urbanhh}</td><td><span class="tag ${cls}">${label}</span></td><td>${r.note}</td></tr>`;
  }).join('');
}
function renderMelghat(){
  document.querySelector('#melghatTable tbody').innerHTML = melghat.map(m=>
    `<tr><td>${m.v}</td><td>${m.zone}</td><td>${m.event}</td><td>${m.year}</td><td>${m.src}</td></tr>`).join('');
}
renderTaluka(talukas); renderMelghat();

const search = document.getElementById('search');
const filterTag = document.getElementById('filterTag');
const filterTaluka = document.getElementById('filterTaluka');
talukas.forEach(r=>{ const o=document.createElement('option'); o.value=r.taluka; o.textContent=r.taluka; filterTaluka.appendChild(o); });
function applyFilter(){
  const q = search.value.trim().toLowerCase(), tag = filterTag.value, tal = filterTaluka.value;
  renderTaluka(talukas.filter(r=>
    (!q || r.taluka.toLowerCase().includes(q) || r.hq.toLowerCase().includes(q) || r.subdiv.toLowerCase().includes(q)) &&
    (!tag || r.hqtag===tag) && (!tal || r.taluka===tal)
  ));
}
search.addEventListener('input', applyFilter);
filterTag.addEventListener('change', applyFilter);
filterTaluka.addEventListener('change', applyFilter);
document.querySelectorAll('#talukaTable th[data-k]').forEach(th=>{
  let asc = true;
  th.addEventListener('click', ()=>{
    const k = th.dataset.k;
    const sorted = [...talukas].sort((a,b)=>{
      let x=a[k], y=b[k];
      if(typeof x === 'string'){ x=x.toLowerCase(); y=y.toLowerCase(); if(x<y) return asc?-1:1; if(x>y) return asc?1:-1; return 0; }
      return asc ? x-y : y-x;
    });
    asc = !asc; renderTaluka(sorted);
  });
});
